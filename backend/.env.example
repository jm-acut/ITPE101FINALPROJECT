PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. The FIRST one is also where payment pages send customers back to.
CLIENT_URL=http://localhost:5173

# Supabase: Project Settings -> API. Use the service_role / secret key. It must never reach the frontend or Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=2h

# Payments: maya (default) or paymongo
PAYMENT_PROVIDER=maya
# Maya sandbox keys are published in Maya's developer documentation ("Sandbox credentials and cards")
MAYA_PUBLIC_KEY=your_maya_sandbox_public_key
MAYA_SECRET_KEY=your_maya_sandbox_secret_key
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
# Only needed if PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# AI build advisor (free key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite